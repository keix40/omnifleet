# Production: set JWT_SECRET (>= 32 chars). Never use defaults outside dev.
JWT_SECRET=
JWT_ISSUER=omnifleet
JWT_AUDIENCE=omnifleet-api

# Local docker-compose / E2E only (allows JWT fallback when JWT_SECRET unset; not for production):
# OMNIFLEET_DEV_MODE=1

# Bootstrap-only (Neon): password for omnifleet_app role — not read by the running API.
OMNIFLEET_APP_PASSWORD=omnifleet_app
# Demo tenant login password when running bootstrap scripts (default: demo-password-change-me)
SEED_DEMO_PASSWORD=

DATABASE_URL=postgres://omnifleet_app:omnifleet_app@localhost:5432/omnifleet?sslmode=disable

# Comma-separated exact origins (credentials). Production must include the Vercel dashboard URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://omnifleet-dashboard.vercel.app

NATS_URL=nats://localhost:4222
# Synadia Cloud: tls://connect.ngs.global, NATS_TLS=true, NATS_CREDS=/path/or/inline-creds
NATS_CREDS=
NATS_TLS=
OMNIFLEET_SHARED_NATS=1
# Render free tier: NATS_EMBEDDED=1 (ephemeral JetStream; events lost on restart)
NATS_EMBEDDED=
AUTH_GRPC_ADDR=localhost:50051
TRACKING_GRPC_ADDR=localhost:50052
ETA_GRPC_ADDR=localhost:50054
DISPATCH_GRPC_ADDR=localhost:50055
BILLING_GRPC_ADDR=localhost:50056
NOTIFICATIONS_GRPC_ADDR=localhost:50057
OSRM_BASE_URL=
STRIPE_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GATEWAY_HTTP_ADDR=0.0.0.0:8080
