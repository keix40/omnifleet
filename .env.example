# Copy to .env for local docker-compose overrides (never commit .env).

# Shared secrets (use strong random values outside dev)
JWT_SECRET=dev-only-change-me

# Postgres
POSTGRES_USER=omnifleet
POSTGRES_PASSWORD=omnifleet
POSTGRES_DB=omnifleet
DATABASE_URL=postgres://omnifleet:omnifleet@localhost:5432/omnifleet?sslmode=disable

# Messaging
NATS_URL=nats://localhost:4222

# Gateway / dashboard
GATEWAY_HTTP_ADDR=0.0.0.0:8080
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# GPS simulator
DRIVER_EMAIL=driver@acme.test
DRIVER_PASSWORD=demo-password-change-me
VEHICLE_ID=eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee

# Stripe (test mode — billing service stub)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
